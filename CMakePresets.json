{
    "version": 2,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 19,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "msvc",
        "displayName": "Visual Studio Compiler",
        "description": "Use Visual Studio Compilers",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/${presetName}",
        "cacheVariables": {
          "CMAKE_C_COMPILER": "cl.exe",
          "CMAKE_CXX_COMPILER": "cl.exe",
          "CMAKE_BUILD_TYPE": "Release"
        }
      },
      {
        "name": "macos",
        "displayName": "macOS (Apple Clang)",
        "description": "Use Apple Clang from the Xcode Command Line Tools",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/${presetName}",
        "cacheVariables": {
          "CMAKE_C_COMPILER": "clang",
          "CMAKE_CXX_COMPILER": "clang++",
          "CMAKE_BUILD_TYPE": "Release"
        }
      }
    ],
    "buildPresets": [
      {
        "name": "msvc",
        "configurePreset": "msvc"
      },
      {
        "name": "macos",
        "configurePreset": "macos"
      }
    ]
}
